# =============================================================================
# .gitignore — git-sync
# Detected: POSIX sh (./git-sync) · Python (ShellParser workflow)
# Docs: Pattern A — track docs/requirements/** ; ignore harness trees
# Artifacts: compiled, caches, temp, secrets ignored
# =============================================================================

# --- secrets / local env ---
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
!*.key.example

# --- OS / editors ---
.DS_Store
.DS_Store?
Thumbs.db
Desktop.ini
ehthumbs.db
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.code-workspace

# --- temp / scratch ---
tmp/
temp/
temps/
*.tmp
*.temp
*.bak
*.orig
*.rej
*.log
logs/
*.pid
*.seed

# --- generic build / compile / package ---
build/
dist/
out/
output/
bin/
obj/
*.o
*.a
*.so
*.dylib
*.dll
*.exe
*.class
*.jar
*.war
*.ear
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
*.whl

# --- caches ---
.cache/
*.cache
.turbo/
.parcel-cache/

# --- Python (ShellParser) ---
__pycache__/
*$py.class
.Python
.venv/
venv/
ENV/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
.hypothesis/
.eggs/
pip-wheel-metadata/

# --- ShellParser generated / dated backups ---
target/
git-sync.20[0-9][0-9][0-9][0-9][0-9][0-9]-*

# --- local specialize / H2 backups (not public) ---
.h2-backup*/
.h1-backup*/
.bootstrap-archive/
selfmanaged
selfmanaged.sha256

# --- Agent harness (root) — local only ---
AGENTS.md
CLAUDE.md
.claude/
.cursor/
.codex/

# --- Docs layer (CIAO) — track requirements only ---
docs/**
!docs/.gitignore
!docs/requirements/
!docs/requirements/**
# already-tracked exception: docs/ShellParser.skill stays in the index

# --- peer agent / housekeeping ---
docs/housekeeping/
